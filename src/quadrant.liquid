{% assign offset = trmnl.user.utc_offset | default: 0 %}
{% assign base_ts = trmnl.system.timestamp_utc | default: 0 %}
{% assign today = base_ts | plus: offset | date: "%Y-%m-%d" %}
{% assign today_label = base_ts | plus: offset | date: "%B %-d" %}
{% assign overdue_count = overdue.size | default: 0 %}
{% assign dateless_count = 0 %}
{% for r in reminders %}
  {% unless r.due_date %}{% assign dateless_count = dateless_count | plus: 1 %}{% endunless %}
{% endfor %}
{% assign today_count = 0 %}
{% for e in events %}
  {% assign ed = e.date_time | date: "%s" | plus: offset | date: "%Y-%m-%d" %}
  {% if ed == today %}{% assign today_count = today_count | plus: 1 %}{% endif %}
{% endfor %}
{% for r in reminders %}
  {% if r.due_date %}
    {% assign rd = r.due_date | date: "%s" | plus: offset | date: "%Y-%m-%d" %}
    {% if rd == today %}{% assign today_count = today_count | plus: 1 %}{% endif %}
  {% endif %}
{% endfor %}
{% assign es = events %}
{% assign rs = reminders | where: "due_date" %}
{% capture reminder_icon %}<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6.5"></circle></svg>{% endcapture %}
<div class="layout layout--top">
  <div class="list" data-overflow="true" data-overflow-counter="true" data-overflow-max-cols="1">
    <span class="label">{{ today_label }}</span>

    {% assign ei = 0 %}
    {% assign ri = 0 %}
    {% assign etot = es.size %}
    {% assign rtot = rs.size %}
    {% assign total = etot | plus: rtot %}
    {% for n in (1..total) %}
      {% if ei < etot and ri < rtot %}
        {% assign et = es[ei].sort_time %}
        {% assign rt = rs[ri].due_date %}
        {% if rt < et %}
          {% assign cur = rs[ri] %}
          {% assign ri = ri | plus: 1 %}
          {% assign kind = "reminder" %}
        {% else %}
          {% assign cur = es[ei] %}
          {% assign ei = ei | plus: 1 %}
          {% assign kind = "event" %}
        {% endif %}
      {% elsif ei < etot %}
        {% assign cur = es[ei] %}
        {% assign ei = ei | plus: 1 %}
        {% assign kind = "event" %}
      {% elsif ri < rtot %}
        {% assign cur = rs[ri] %}
        {% assign ri = ri | plus: 1 %}
        {% assign kind = "reminder" %}
      {% endif %}
      {% assign cd = cur.date_time | default: cur.due_date | date: "%s" | plus: offset | date: "%Y-%m-%d" %}
      {% if cd == today %}
        <div class="item">
          <div class="meta">
            {% if kind == "event" %}
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="1.5" y="2.5" width="13" height="12" rx="1.5"></rect>
                <path d="M1.5 6.5h13"></path>
                <path d="M5.5 1v3M10.5 1v3"></path>
              </svg>
            {% else %}
              {{ reminder_icon }}
            {% endif %}
          </div>
          <div class="content">
            <span class="title title--small">{{ cur.prefix }}{{ cur.title | escape }}</span>
            {% if cur.description %}<span class="description">{{ cur.description | escape }}</span>{% endif %}
            {% if kind == "event" %}
              {% if cur.range %}
                <div class="flex gap--xsmall"><span class="label label--small label--underline">{{ cur.range | escape }}</span></div>
              {% elsif cur.time_label %}
                <div class="flex gap--xsmall"><span class="label label--small label--underline">{{ cur.time_label | escape }}</span></div>
              {% endif %}
            {% else %}
              {% if cur.due_time_label %}
                <div class="flex gap--xsmall"><span class="label label--small label--underline">{{ cur.due_time_label | escape }}</span></div>
              {% endif %}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if today_count > 0 and (overdue_count > 0 or dateless_count > 0) %}<div class="divider"></div>{% endif %}
    {% for r in overdue %}
      <div class="item">
        <div class="meta">
          {{ reminder_icon }}
        </div>
        <div class="content">
          <span class="title title--small">{{ r.prefix }}{{ r.title | escape }}</span>
          {% if r.description %}<span class="description">{{ r.description | escape }}</span>{% endif %}
          {% if r.due_date_label %}
            <div class="flex gap--xsmall"><span class="label label--small label--underline">{{ r.due_date_label | escape }}</span></div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
    {% if overdue_count > 0 and dateless_count > 0 %}<div class="divider"></div>{% endif %}
    {% for r in reminders %}
      {% unless r.due_date %}
        <div class="item">
          <div class="meta">
            {{ reminder_icon }}
          </div>
          <div class="content">
            <span class="title title--small">{{ r.prefix }}{{ r.title | escape }}</span>
            {% if r.description %}<span class="description">{{ r.description | escape }}</span>{% endif %}
          </div>
        </div>
      {% endunless %}
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name | escape }}</span>
  <span class="instance"></span>
</div>
