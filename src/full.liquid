<div class="layout flex--top">
  <div class="columns">
    {% for day in days %}
      <div class="column">
        <div class="list" data-overflow="true" data-overflow-counter="true">
          <span class="label">{{ day.label }}</span>
          {% for item in day.items %}
            {% if item.type == "divider" %}
              <div class="divider"></div>
            {% else %}
              <div class="item">
                <div class="meta">
                  {% if item.type == "event" %}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="1.5" y="2.5" width="13" height="12" rx="1.5"></rect>
                      <path d="M1.5 6.5h13"></path>
                      <path d="M5.5 1v3M10.5 1v3"></path>
                    </svg>
                  {% else %}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                      <circle cx="8" cy="8" r="6.5"></circle>
                    </svg>
                  {% endif %}
                </div>
                <div class="content">
                  <span class="title title--small">{{ item.title }}</span>
                  {% if item.description %}
                    <span class="description">{{ item.description }}</span>
                  {% endif %}
                  {% if item.time %}
                    <div class="flex gap--xsmall">
                      <span class="label label--small label--underline">{{ item.time }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">
    {{ trmnl.plugin_settings.instance_name }}
  </span>
  <span class="instance">Description</span>
</div>
